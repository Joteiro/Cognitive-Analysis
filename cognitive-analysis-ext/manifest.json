{
  "manifest_version": 3,
  "name": "Cognitive Analysis",
  "version": "0.2.0",
  "description": "Muestra la composicion medible de un video de YouTube junto al video, y registra el consumo para la dieta cognitiva.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*",
    "https://*.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
